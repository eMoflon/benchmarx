DEFINITIONS
    
    // comment this for AB
    
    	STR1 == STRING ; 
    	sepDef == sep : STR1 & sep = ", "  ;
    
    
    // comment this for ProB
    /*
    	sepDef == sep : STR1 ;
    */
    
    
    STR2 == seq(STR1) ;
    
    
    familyOf == (((theFather \/ theMother) \/ theSons) \/ theDaughters) ;
    
    isFemale(self) ==  self : dom(theMother \/ theDaughters) ;
    familyName(self) == Families_Family_name(familyOf(self)) ;
    
    theMembers == familyOf~[families~[{fmlRoot}]] ;
    thePersons == persons~[{prsRoot}] ;
    mapped == (pMap~ ; mMap) 
    
    
