datatype RULE =   Member2Person_
                | ForwardDelete_
                | ForwardRename_
                | ForwardRepairGender_

channel testIncrementalInserts,
        testIncrementalDeletions,
        testIncrementalRename,
        assertPrecondition,
        assertPostcondition,
        testIncrementalMove,
        testIncrementalMixed,
        testIncrementalMoveRoleChange,
        testStability,
        testHippocraticness : Bool

channel sync, unsync,
        createInitialFamilies,
        setBirthdayOfRod,
        setBirthdayOfFatherBart,
        changeAllBirthdays,
        setBirthdayOfYoungerBart,
        createNewFamilySimpsonWithMembers,
        createSonBart,
        deleteFirstSonBart,
        renameSimpsonToBouvier,
        createFatherNed,
        createMotherMaude,
        createSonTodd,
        moveLisa,
        moveMarge,
        deleteFatherHomer,
        createFatherHomer,
        moveMaggieAndChangeRole,
        idleDelta,
        hippocraticDelta

channel propagate : RULE

MAIN =
        testIncrementalInserts.true
            -> createInitialFamilies
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> PRE ;
            createFatherNed
            -> createMotherMaude
            -> createSonTodd -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testIncrementalDeletions.true
            -> createInitialFamilies
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> PRE ;
            createSonBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            deleteFirstSonBart -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testIncrementalRename.true
            -> createInitialFamilies
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> PRE ;
            renameSimpsonToBouvier -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testIncrementalMove.true
            -> createInitialFamilies
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> PRE ;
            moveLisa
            -> moveMarge -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testIncrementalMixed.true
            -> createInitialFamilies
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> PRE ;
            deleteFatherHomer -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            createFatherHomer -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testIncrementalMoveRoleChange.true
            -> createInitialFamilies
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> PRE ;
            moveMaggieAndChangeRole -> unsync -- abnormal state
            -> PROPAGATE_UNTIL_STOP
    []
        testStability.true
            -> createNewFamilySimpsonWithMembers 
            -> createSonBart 
            -> PROPAGATE_UNTIL_SYNC ; CHECK_POST ;
            idleDelta -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testHippocraticness.true
            -> createNewFamilySimpsonWithMembers
            -> createSonBart
            -> PROPAGATE_UNTIL_SYNC ; CHECK_POST ;
            hippocraticDelta -> unsync
            -> PROPAGATE_UNTIL_STOP

PROPAGATE_UNTIL_SYNC =
        [] r : RULE @ propagate!r -> PROPAGATE_UNTIL_SYNC
    []
        sync -> SKIP

PRE =
        assertPrecondition.true -> SKIP
    []
        assertPrecondition.false -> STOP

PROPAGATE_UNTIL_STOP =
        [] r : RULE @ propagate!r -> PROPAGATE_UNTIL_STOP
    []
        sync -> POST

POST =
        assertPostcondition.true -> STOP
    []
        assertPostcondition.false -> STOP

CHECK_POST =
        assertPostcondition.true -> SKIP
    []
        assertPostcondition.false -> STOP