channel testInitialiseSynchronisation,
    testFamilyNameChangeOfEmpty,
    testCreateFamily,
    testCreateFamilyMember,
    testNewFamilyWithMultiMembers,
    testNewDuplicateFamilyNames,
    testDuplicateFamilyMemberNames,
    assertPrecondition,
    assertPostcondition : Bool

channel noPrecondition,
    propagate,
    createSimpsonFamily,
    renameEmptySimpsonToBouvier,
    createSkinnerFamily,
    createFlandersFamilySonRod,
    createNewFamilySimpsonWithMembers,
    createFatherBart,
    createSonBart

MAIN =
      testInitialiseSynchronisation.true
          -> noPrecondition
          -> TRANSFORM

  []
      testFamilyNameChangeOfEmpty.true
          -> createSimpsonFamily
          -> PRE ; renameEmptySimpsonToBouvier
          -> TRANSFORM

  []
      testCreateFamily.true
          -> noPrecondition
          -> createSkinnerFamily
          -> TRANSFORM

  []
      testCreateFamilyMember.true
          -> noPrecondition
          -> createFlandersFamilySonRod
          -> TRANSFORM

  []
      testNewFamilyWithMultiMembers.true
          -> noPrecondition
          -> createFlandersFamilySonRod
          -> createNewFamilySimpsonWithMembers
          -> TRANSFORM

  []
      testNewDuplicateFamilyNames.true
          -> noPrecondition
          -> createNewFamilySimpsonWithMembers
          -> createSimpsonFamily
          -> createFatherBart
          -> TRANSFORM

  []
      testDuplicateFamilyMemberNames.true
          -> noPrecondition
          -> createNewFamilySimpsonWithMembers
          -> createSonBart
          -> TRANSFORM


TRANSFORM =
      propagate -> TRANSFORM
  []
      POST


PRE =
      assertPrecondition.true  -> SKIP
  []
      assertPrecondition.false -> STOP


POST =
      assertPostcondition.true  -> STOP
  []
      assertPostcondition.false -> STOP