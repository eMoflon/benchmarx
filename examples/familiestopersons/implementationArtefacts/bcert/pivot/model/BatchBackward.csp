channel testCreateMalePersonAsParent,
        testCreateMalePersonAsParent2,
        testCreateFamilyMembersInExistingFamilyAsParents,
        testCreateMalePersonAsSon,
        testCreateMalePersonAsSon2,
        testCreateFamilyMembersInExistingFamilyAsChildren,
        testCreateDuplicateFamilyMembersInExistingFamilyAsChildren,
        testCreateFamilyMembersInNewFamilyAsParents,
        testCreateDuplicateFamilyMembersInNewFamilyAsParents,
        testCreateFamilyMembersInNewFamilyAsChildren,
        testCreateDuplicateFamilyMembersInNewFamilyAsChildren,
        assertPostcondition : Bool

channel noPrecondition,
        createRod,
        createHomer,
        createBart,
        createMarge,
        createLisa,
        createMaggie,
        propagate

MAIN =
        testCreateMalePersonAsParent.true
            -> noPrecondition
            -> createRod
            -> TRANSFORM

    []  testCreateFamilyMembersInExistingFamilyAsParents.true
            -> noPrecondition
            -> createRod
            -> createHomer
            -> createMarge
            -> TRANSFORM

    []  testCreateMalePersonAsSon.true
            -> noPrecondition
            -> createRod
            -> TRANSFORM

    []  testCreateFamilyMembersInExistingFamilyAsChildren.true
            -> noPrecondition
            -> createRod
            -> createHomer
            -> createBart
            -> createMarge
            -> createLisa
            -> createMaggie
            -> TRANSFORM

    []  testCreateDuplicateFamilyMembersInExistingFamilyAsChildren.true
            -> noPrecondition
            -> createRod
            -> createBart
            -> createHomer
            -> createBart
            -> createBart
            -> createMarge
            -> createLisa
            -> createMaggie
            -> TRANSFORM
    
    []  testCreateMalePersonAsParent2.true
            -> noPrecondition
            -> createRod
            -> TRANSFORM

    []  testCreateFamilyMembersInNewFamilyAsParents.true
            -> noPrecondition
            -> createRod
            -> createHomer
            -> createBart
            -> createMarge
            -> createLisa
            -> createMaggie
            -> TRANSFORM

    []  testCreateDuplicateFamilyMembersInNewFamilyAsParents.true
            -> noPrecondition
            -> createRod
            -> createBart
            -> createHomer
            -> createBart
            -> createBart
            -> createMarge
            -> createLisa
            -> createMaggie
            -> TRANSFORM

    []  testCreateMalePersonAsSon2.true
            -> noPrecondition
            -> createRod
            -> TRANSFORM
            
    []  testCreateFamilyMembersInNewFamilyAsChildren.true
            -> noPrecondition
            -> createRod
            -> createHomer
            -> createBart
            -> createMarge
            -> createLisa
            -> createMaggie
            -> TRANSFORM

    []  testCreateDuplicateFamilyMembersInNewFamilyAsChildren.true
            -> noPrecondition
            -> createRod
            -> createBart
            -> createHomer
            -> createBart
            -> createBart
            -> createMarge
            -> createLisa
            -> createMaggie
            -> TRANSFORM

TRANSFORM =
        propagate -> TRANSFORM
    []
        POST

POST =
        assertPostcondition.true  -> STOP
    []
        assertPostcondition.false -> STOP