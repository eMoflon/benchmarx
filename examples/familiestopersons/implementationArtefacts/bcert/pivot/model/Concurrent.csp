datatype RULE =
    ConcurrentDeleteMatched_
  | ConcurrentMatchMemberPerson_
  | ConcurrentTargetRenameWins_
  | Member2Person_
  | ForwardDelete_
  | ForwardRename_
  | Person2MemberExistingFamily_
  | Person2MemberNewFamily_
  | BackwardDelete_
  | BackwardRenameMemberName_

channel testSuitableFamilyNonMatchingMember,
        testSuitableFamilyMatchingMember,
        testNonSuitableFamily,
        testCombinedCases,
        assertPrecondition,
        assertPostcondition,
        testMatchingDeletion,
        testNonMatchingDeletion,
        testCombinedDeletionCases,
        testCombinedDeletionAndCreation,
        testCombinedRenameDelete,
        testDeleteRenameConflict,
        testMoveDeleteConflict,
        testMoveRenameConflict,
        testRenameRenameConflict : Bool

channel sync,
        unsync,
        fwd,bwd,
        makeDecisionEAndP,
        makeDecisionENotP,
        makeDecisionNotENotP,
        createSimpsonFamily,
        createFatherHomer,
        createSonBart,
        createBart,
        createHomer,
        createSeymour,
        setBirthdayOfSeymour,
        changeAllBirthdays,
        createInitialFamilies,
        createNewFamilySimpsonWithMembers,
        setBirthdayOfRod,
        setBirthdayOfFatherBart,
        setBirthdayOfYoungerBart,
        deleteFatherHomer,
        deleteRodAsSon,
        deleteHomer,
        deleteMaggie,
        createSonBartInCompleteSimpson,
        createFatherNed,
        nameChangeOfLisa,
        deleteMarge,
        createNewFamilyFlandersWithMembers,
        setBirthdayOfLisa,
        deleteLisa,
        deletePersonLisa,
        moveLisaToFlandersAsDaughter,
        familyNameChangeOfLisaToVanHouten,
        nameChangeOfLisaInFamily

channel propagate : RULE

MAIN =
        -- Monotonic Creating --

        testSuitableFamilyNonMatchingMember.true
            -> createSimpsonFamily
            -> createFatherHomer
            -> createBart
            -> changeAllBirthdays
            -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testSuitableFamilyMatchingMember.true
            -> createSimpsonFamily
            -> createFatherHomer
            -> createHomer
            -> changeAllBirthdays
            -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testNonSuitableFamily.true
            -> makeDecisionEAndP
            -> createSimpsonFamily
            -> createFatherHomer
            -> createSeymour
            -> setBirthdayOfSeymour
            -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testCombinedCases.true
            -> makeDecisionENotP
            -> createSimpsonFamily
            -> createFatherHomer
            -> createSonBart
            -> createHomer
            -> createSeymour
            -> changeAllBirthdays
            -> setBirthdayOfSeymour
            -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        -- Monotonic Deleting --

        testMatchingDeletion.true
            -> createInitialFamilies -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBartInCompleteSimpson -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> deleteFatherHomer
            -> deleteHomer
            -> unsync
            -> PROPAGATE_UNTIL_STOP

    []
        testNonMatchingDeletion.true
            -> createInitialFamilies -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBartInCompleteSimpson -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> deleteFatherHomer
            -> deleteMaggie
            -> unsync
            -> PROPAGATE_UNTIL_STOP

    []
        testCombinedDeletionCases.true
            -> createInitialFamilies -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBartInCompleteSimpson -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> deleteFatherHomer
            -> deleteRodAsSon
            -> deleteHomer
            -> deleteMaggie
            -> unsync
            -> PROPAGATE_UNTIL_STOP
    []  
        -- Non Monotonic --
        
        testCombinedDeletionAndCreation.true
            -> createInitialFamilies -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBartInCompleteSimpson -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> deleteFatherHomer
            -> createFatherNed
            -> deleteMarge
            -> deleteHomer
            -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testCombinedRenameDelete.true
            -> createInitialFamilies -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBartInCompleteSimpson -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> deleteFatherHomer
            -> nameChangeOfLisa
            -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        -- Conflicts --

        testDeleteRenameConflict.true
            -> createNewFamilySimpsonWithMembers
            -> createNewFamilyFlandersWithMembers
            -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfLisa
            -> PRE ;
            makeDecisionENotP
            -> deleteLisa
            -> nameChangeOfLisa
            -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testMoveDeleteConflict.true
            -> createNewFamilySimpsonWithMembers
            -> createNewFamilyFlandersWithMembers
            -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfLisa
            -> PRE ;
            moveLisaToFlandersAsDaughter
            -> deletePersonLisa
            -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testMoveRenameConflict.true
            -> createNewFamilySimpsonWithMembers
            -> createNewFamilyFlandersWithMembers
            -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfLisa
            -> PRE ;
            makeDecisionNotENotP
            -> moveLisaToFlandersAsDaughter
            -> familyNameChangeOfLisaToVanHouten
            -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testRenameRenameConflict.true
            -> createNewFamilySimpsonWithMembers
            -> createNewFamilyFlandersWithMembers
            -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfLisa
            -> PRE ;
            nameChangeOfLisaInFamily
            -> nameChangeOfLisa
            -> unsync
            -> PROPAGATE_UNTIL_STOP

POST =
        assertPostcondition.true -> STOP
    []
        assertPostcondition.false -> STOP

PRE =
        assertPrecondition.true -> SKIP
    []
        assertPrecondition.false -> STOP

PROPAGATE_UNTIL_SYNC =
        [] r : RULE @ propagate!r -> PROPAGATE_UNTIL_SYNC
    []
        sync -> SKIP

PROPAGATE_UNTIL_STOP =
        [] r : RULE @ propagate!r -> PROPAGATE_UNTIL_STOP
    []
        sync -> POST