datatype RULE =
    Person2MemberExistingFamily_
  | Person2MemberNewFamily_
  | BackwardDelete_
  | BackwardRenameMemberName_
  | BackwardMoveMaleToExistingFamily_
  | BackwardMoveFemaleToExistingFamily_
  | BackwardMoveMaleToNewFamily_
  | BackwardMoveFemaleToNewFamily_

channel testIncrementalInsertsFixedConfig,
        testIncrementalInsertsDynamicConfig,
        assertPrecondition,
        assertPostcondition,
        testIncrementalDeletions,
        testIncrementalRenamingDynamic,
        testIncrementalMixedDynamic,
        testIncrementalOperational,
        testStability,
        testHippocraticness : Bool

channel sync,
        unsync,
        createHomer,
        createMaggie,
        createSeymour,
        createBart,
        createLisa,
        setBirthdaysOfSimpson,
        makeDecisionEAndP,
        makeDecisionENotP,
        makeDecisionNotEAndP,
        makeDecisionNotENotP,
        deleteHomer,
        deleteMaggie,
        createRod,
        createMarge,
        setBirthdayOfRod,
        changeAllBirthdays,
        setBirthdayOfYoungerBart,
        setBirthdayOfFatherBart,
        firstNameChangeOfBart,
        fullNameChangeOfOtherBart,
        fullNameChangeOfFatherBart,
        familyNameChangeOfLisa,
        fullNameChangeOfMarge,
        setBirthdayOfMaggie,
        idleDelta,
        hippocraticDelta

channel propagate : RULE

MAIN =
        testIncrementalInsertsFixedConfig.true
            -> makeDecisionEAndP
            -> createHomer
            -> createMaggie -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdaysOfSimpson
            -> PRE ;
            createSeymour -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            CHECK_POST ;
            createSeymour -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testIncrementalInsertsDynamicConfig.true
            -> makeDecisionEAndP
            -> createHomer
            -> createMaggie -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdaysOfSimpson
            -> PRE ;

            createSeymour -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            CHECK_POST ;

            createSeymour -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            CHECK_POST ;

            makeDecisionNotEAndP
            -> createSeymour -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            CHECK_POST ;

            makeDecisionNotENotP
            -> createSeymour -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            CHECK_POST ;

            makeDecisionEAndP
            -> createSeymour -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            CHECK_POST ;

            makeDecisionENotP
            -> createBart
            -> createLisa -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testIncrementalDeletions.true
            -> makeDecisionEAndP
            -> createHomer -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            makeDecisionENotP
            -> createMaggie -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            setBirthdaysOfSimpson
            -> PRE ;
            deleteHomer -> unsync
            -> PROPAGATE_UNTIL_SYNC ;
            deleteMaggie -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testIncrementalRenamingDynamic.true
            -> makeDecisionENotP
            -> createRod -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            setBirthdayOfRod
            -> makeDecisionNotEAndP
            -> createHomer -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            makeDecisionEAndP
            -> createMarge
            -> createBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            createLisa
            -> createMaggie -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            changeAllBirthdays
            -> createBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            setBirthdayOfYoungerBart
            -> makeDecisionNotEAndP
            -> createBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            setBirthdayOfFatherBart
            -> PRE ;

            firstNameChangeOfBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            makeDecisionEAndP
            -> fullNameChangeOfOtherBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            makeDecisionENotP
            -> fullNameChangeOfFatherBart -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            makeDecisionNotENotP
            -> familyNameChangeOfLisa -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            makeDecisionNotEAndP
            -> fullNameChangeOfMarge -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testIncrementalMixedDynamic.true
            -> makeDecisionEAndP
            -> createMaggie -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            createHomer -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            setBirthdaysOfSimpson
            -> PRE ;

            makeDecisionENotP
            -> deleteHomer
            -> createHomer -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testIncrementalOperational.true
            -> makeDecisionENotP
            -> createMaggie -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            setBirthdayOfMaggie
            -> PRE ;

            makeDecisionEAndP
            -> createMarge
            -> createLisa
            -> createHomer
            -> createBart
            -> createMaggie
            -> createLisa -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            makeDecisionNotEAndP
            -> createLisa -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testStability.true
            -> makeDecisionEAndP
            -> createRod
            -> createHomer
            -> createMarge -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            CHECK_POST ;

            idleDelta -> unsync
            -> PROPAGATE_UNTIL_STOP
    []
        testHippocraticness.true
            -> makeDecisionEAndP
            -> createRod
            -> createHomer
            -> createMarge -> unsync
            -> PROPAGATE_UNTIL_SYNC ;

            CHECK_POST ;

            hippocraticDelta -> unsync
            -> PROPAGATE_UNTIL_STOP

PROPAGATE_UNTIL_SYNC =
        [] r : RULE @ propagate!r -> PROPAGATE_UNTIL_SYNC
    []
        sync -> SKIP

PROPAGATE_UNTIL_STOP =
        [] r : RULE @ propagate!r -> PROPAGATE_UNTIL_STOP
    []
        sync -> POST

PRE =
        assertPrecondition.true -> SKIP
    []
        assertPrecondition.false -> STOP

POST =
        assertPostcondition.true -> STOP
    []
        assertPostcondition.false -> STOP

CHECK_POST =
        assertPostcondition.true -> SKIP
    []
        assertPostcondition.false -> STOP