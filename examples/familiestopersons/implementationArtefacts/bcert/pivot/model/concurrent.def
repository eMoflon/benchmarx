DEFINITIONS
/* concurrent.def */

HasConcurrentDeleteMatched ==
  #(aMapping).(
    aMapping : Mapping &
    mapping(aMapping) = pvtRoot &
    aMapping /: dom(mMap) &
    aMapping /: dom(pMap)
  );

HasConcurrentMatchMemberPerson ==
  #(aMember,aPerson).(
    aMember : theMembers &
    aMember /: ran(mMap) &
    aPerson : thePersons &
    aPerson /: dom(mapped) &
    Persons_Person_name(aPerson) =
      STRING_CONC([
        Families_Family_name(familyOf(aMember)),
        ", ",
        Families_FamilyMember_name(aMember)
      ])
  );

HasConcurrentTargetRenameWins ==
  #(aMapping).(
    aMapping : Mapping &
    mapping(aMapping) = pvtRoot &
    aMapping : dom(mMap) &
    aMapping : dom(pMap) &
    PersonFamilyName(pMap(aMapping)) =
      Families_Family_name(familyOf(mMap(aMapping))) &
    PersonMemberName(pMap(aMapping)) /=
      Families_FamilyMember_name(mMap(aMapping))
  );

HasForwardDelete ==
  #(aMapping).(
    aMapping : Mapping &
    aMapping : dom(pMap) &
    aMapping /: dom(mMap) &
    mapping(aMapping) = pvtRoot
  );

HasForwardRename ==
  #(aMapping).(
    aMapping : Mapping &
    mapping(aMapping) = pvtRoot &
    aMapping : dom(mMap) &
    aMapping : dom(pMap) &
    Persons_Person_name(pMap(aMapping)) /=
      STRING_CONC([
        Families_Family_name(familyOf(mMap(aMapping))),
        ", ",
        Families_FamilyMember_name(mMap(aMapping))
      ])
  );

HasBackwardDelete ==
  #(aMapping).(
    aMapping : Mapping &
    aMapping : dom(mMap) &
    aMapping /: dom(pMap) &
    mapping(aMapping) = pvtRoot
  );

HasBackwardRename ==
  #(aMapping).(
    aMapping : Mapping &
    mapping(aMapping) = pvtRoot &
    aMapping : dom(mMap) &
    aMapping : dom(pMap) &
    PersonFamilyName(pMap(aMapping)) =
      Families_Family_name(familyOf(mMap(aMapping))) &
    PersonMemberName(pMap(aMapping)) /=
      Families_FamilyMember_name(mMap(aMapping))
  ) ;