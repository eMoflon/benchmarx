datatype RULE =
    ConcurrentDeleteMatched_
  | ConcurrentMatchMemberPerson_
  | ConcurrentTargetRenameWins_
  | Member2Person_
  | ForwardDelete_
  | ForwardRename_
  | Person2MemberExistingFamily_
  | Person2MemberNewFamily_
  | BackwardDelete_
  | BackwardRenameMemberName_
  | BackwardMoveMaleToExistingFamily_
  | BackwardMoveFemaleToExistingFamily_
  | BackwardMoveMaleToNewFamily_
  | BackwardMoveFemaleToNewFamily_

channel testRoundtripEdit,
        testRoundtripAdd,
        testRoundtripDelete,
        assertPrecondition,
        assertPostcondition : Bool

channel sync,
        unsync,
        fwd,
        bwd,
        makeDecisionENotP,
        createInitialFamilies,
        createNewFamilySimpsonWithMembers,
        createSonBartInCompleteSimpson,
        setBirthdayOfRod,
        setBirthdayOfFatherBart,
        setBirthdayOfYoungerBart,
        changeAllBirthdays,
        firstNameChangeOfHomer,
        renameFlandersFamilyToBouvier,
        createSeymour,
        createSonTodd,
        deleteMarge,
        deleteRodAsSon

channel propagate : RULE

MAIN =
        testRoundtripEdit.true
            -> createInitialFamilies -> unsync
            -> fwd -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> fwd -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBartInCompleteSimpson -> unsync
            -> fwd -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> PRE ;
            firstNameChangeOfHomer -> unsync
            -> bwd -> PROPAGATE_UNTIL_SYNC ;
            renameFlandersFamilyToBouvier -> unsync
            -> fwd -> PROPAGATE_UNTIL_STOP

    []
        testRoundtripAdd.true
            -> makeDecisionENotP
            -> createInitialFamilies -> unsync
            -> fwd -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> fwd -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBartInCompleteSimpson -> unsync
            -> fwd -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> PRE ;
            createSeymour -> unsync
            -> bwd -> PROPAGATE_UNTIL_SYNC ;
            createSonTodd -> unsync
            -> fwd -> PROPAGATE_UNTIL_STOP

    []
        testRoundtripDelete.true
            -> createInitialFamilies -> unsync
            -> fwd -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfRod
            -> setBirthdayOfFatherBart
            -> createNewFamilySimpsonWithMembers -> unsync
            -> fwd -> PROPAGATE_UNTIL_SYNC ;
            changeAllBirthdays
            -> createSonBartInCompleteSimpson -> unsync
            -> fwd -> PROPAGATE_UNTIL_SYNC ;
            setBirthdayOfYoungerBart
            -> PRE ;
            deleteMarge -> unsync
            -> bwd -> PROPAGATE_UNTIL_SYNC ;
            deleteRodAsSon -> unsync
            -> fwd -> PROPAGATE_UNTIL_STOP

PRE =
        assertPrecondition.true -> SKIP
    []
        assertPrecondition.false -> STOP

POST =
        assertPostcondition.true -> STOP
    []
        assertPostcondition.false -> STOP

PROPAGATE_UNTIL_SYNC =
    [] d : RULE @ propagate!d -> PROPAGATE_UNTIL_SYNC
  []
    sync -> SKIP

PROPAGATE_UNTIL_STOP =
    [] d : RULE @ propagate!d -> PROPAGATE_UNTIL_STOP
  []
    sync -> POST