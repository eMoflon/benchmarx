<?xml version="1.0" encoding="UTF-8"?>
<pivot:Pivot xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Persons="platform:/plugin/Persons/model/Persons.ecore" xmlns:pivot="http://pivot" xsi:schemaLocation="platform:/plugin/Persons/model/Persons.ecore ../Persons/model/Persons.ecore http://pivot ../pivot/model/pivot.ecore" name="testIncrementalDeletions" strategie="FWD" sync="true">
  <familyModel href="testIncrementalDeletionsFam.xmi#/"/>
  <personModel href="testIncrementalDeletionsPer.xmi#/"/>
  <pre name="Pre_IncrFwdForDeletion">
    <output href="Expected/Pre_IncrFwdPersonForDeletion.xmi#/"/>
    <input href="Expected/Pre_IncrFwdFamilyForDeletion.xmi#/"/>
  </pre>
  <post name="Post_IncrFwdDeletion">
    <output href="Expected/PersonAfterDeletion.xmi#/"/>
    <input href="Expected/FamilyAfterDeletion.xmi#/"/>
  </post>
  <mapping>
    <mMap href="testIncrementalDeletionsFam.xmi#//@families.1/@sons.0"/>
    <pMap xsi:type="Persons:Male" href="testIncrementalDeletionsPer.xmi#//@persons.0"/>
  </mapping>
  <mapping>
    <mMap href="testIncrementalDeletionsFam.xmi#//@families.0/@father"/>
    <pMap xsi:type="Persons:Male" href="testIncrementalDeletionsPer.xmi#//@persons.1"/>
  </mapping>
  <mapping>
    <mMap href="testIncrementalDeletionsFam.xmi#//@families.3/@father"/>
    <pMap xsi:type="Persons:Male" href="testIncrementalDeletionsPer.xmi#//@persons.2"/>
  </mapping>
  <mapping>
    <mMap href="testIncrementalDeletionsFam.xmi#//@families.3/@mother"/>
    <pMap xsi:type="Persons:Female" href="testIncrementalDeletionsPer.xmi#//@persons.3"/>
  </mapping>
  <mapping>
    <mMap href="testIncrementalDeletionsFam.xmi#//@families.3/@daughters.1"/>
    <pMap xsi:type="Persons:Female" href="testIncrementalDeletionsPer.xmi#//@persons.4"/>
  </mapping>
  <mapping>
    <mMap href="testIncrementalDeletionsFam.xmi#//@families.3/@daughters.0"/>
    <pMap xsi:type="Persons:Female" href="testIncrementalDeletionsPer.xmi#//@persons.5"/>
  </mapping>
  <mapping>
    <mMap href="testIncrementalDeletionsFam.xmi#//@families.3/@sons.0"/>
    <pMap xsi:type="Persons:Male" href="testIncrementalDeletionsPer.xmi#//@persons.6"/>
  </mapping>
</pivot:Pivot>
