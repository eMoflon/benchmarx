<?xml version="1.0" encoding="UTF-8"?>
<pivot:Pivot xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Persons="platform:/plugin/Persons/model/Persons.ecore" xmlns:pivot="http://pivot" xsi:schemaLocation="platform:/plugin/Persons/model/Persons.ecore ../Persons/model/Persons.ecore http://pivot ../pivot/model/pivot.ecore" name="testIncrementalInsertsFixedConfig" FAMILY_TO_NEW="true" PARENT_TO_CHILD="true" sync="true">
  <familyModel href="testIncrementalInsertsFixedConfigFam.xmi#/"/>
  <personModel href="testIncrementalInsertsFixedConfigPer.xmi#/"/>
  <pre name="Pre_IncrBwd">
    <output href="Expected/Pre_IncrBwdPerson.xmi#/"/>
    <input href="Expected/Pre_IncrBwdFamily.xmi#/"/>
  </pre>
  <post name="Post_IncrBwdInsertion1">
    <output href="Expected/PersonAfterBwdInsertion1.xmi#/"/>
    <input href="Expected/FamilyAfterBwdInsertion1.xmi#/"/>
  </post>
  <post name="Post_IncrBwdInsertion2">
    <output href="Expected/PersonAfterBwdInsertion2.xmi#/"/>
    <input href="Expected/FamilyAfterBwdInsertion2.xmi#/"/>
  </post>
  <mapping>
    <mMap href="testIncrementalInsertsFixedConfigFam.xmi#//@families.0/@father"/>
    <pMap xsi:type="Persons:Male" href="testIncrementalInsertsFixedConfigPer.xmi#//@persons.0"/>
  </mapping>
  <mapping>
    <mMap href="testIncrementalInsertsFixedConfigFam.xmi#//@families.0/@mother"/>
    <pMap xsi:type="Persons:Female" href="testIncrementalInsertsFixedConfigPer.xmi#//@persons.1"/>
  </mapping>
  <mapping>
    <mMap href="testIncrementalInsertsFixedConfigFam.xmi#//@families.1/@father"/>
    <pMap xsi:type="Persons:Male" href="testIncrementalInsertsFixedConfigPer.xmi#//@persons.2"/>
  </mapping>
  <mapping>
    <mMap href="testIncrementalInsertsFixedConfigFam.xmi#//@families.1/@sons.0"/>
    <pMap xsi:type="Persons:Male" href="testIncrementalInsertsFixedConfigPer.xmi#//@persons.3"/>
  </mapping>
</pivot:Pivot>
