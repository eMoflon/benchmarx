<?xml version="1.0" encoding="UTF-8"?>
<pivot:Pivot xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Persons="platform:/plugin/Persons/model/Persons.ecore" xmlns:pivot="http://pivot" xsi:schemaLocation="platform:/plugin/Persons/model/Persons.ecore ../Persons/model/Persons.ecore http://pivot ../pivot/model/pivot.ecore" name="testStability" FAMILY_TO_NEW="true" PARENT_TO_CHILD="true" sync="true">
  <familyModel href="testStabilityFam.xmi#/"/>
  <personModel href="testStabilityPer.xmi#/"/>
  <post name="Post_Stability">
    <output href="Expected/PersonsMultiDeterministic.xmi#/"/>
    <input href="Expected/FamilyWithParentsOnly.xmi#/"/>
  </post>
  <mapping>
    <mMap href="testStabilityFam.xmi#//@families.0/@father"/>
    <pMap xsi:type="Persons:Male" href="testStabilityPer.xmi#//@persons.0"/>
  </mapping>
  <mapping>
    <mMap href="testStabilityFam.xmi#//@families.1/@father"/>
    <pMap xsi:type="Persons:Male" href="testStabilityPer.xmi#//@persons.1"/>
  </mapping>
  <mapping>
    <mMap href="testStabilityFam.xmi#//@families.1/@mother"/>
    <pMap xsi:type="Persons:Female" href="testStabilityPer.xmi#//@persons.2"/>
  </mapping>
</pivot:Pivot>
